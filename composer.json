{
    "name": "kaninphp/kaninphp",
    "description": "KaninPHP: a lightweight, API-first PHP framework for beginners.",
    "type": "project",
    "keywords": [
        "framework",
        "kaninphp",
        "api",
        "rest"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Kanin\\": "system/",
            "App\\": "app/"
        },
        "files": [
            "system/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
