# Copy this file to .env and adjust the values for your machine.

APP_NAME=KaninPHP
APP_ENV=local
# Set APP_DEBUG=false in production so errors never leak details.
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# sqlite needs no server. For mysql/pgsql also set DB_HOST, DB_PORT,
# DB_DATABASE, DB_USERNAME and DB_PASSWORD.
DB_CONNECTION=sqlite

# Comma-separated list of allowed origins, or * for any origin.
CORS_ALLOWED_ORIGINS=*

# Comma-separated bearer tokens accepted by the auth.token middleware.
# Generate a strong one with: php -r "echo bin2hex(random_bytes(32));"
API_TOKENS=change-me
